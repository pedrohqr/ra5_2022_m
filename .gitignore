# Cache local do easyeda2kicad (regeravel, nao precisa versionar)
.easyeda_cache/

# Historico local do VS Code (extensao Local History)
.history/

# Backups e arquivos temporarios do KiCad
*-backups/
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_prl
fp-info-cache
_autosave-*
*.tmp

# Arquivos de lock do KiCad (criados enquanto o projeto esta aberto)
~*.lck

# Snapshots de backup/restore locais (ex: gerados por ferramentas/hooks)
_restore_backup_*/

# A pasta libraries/ (componentes importados) DEVE ser versionada.
